#!/bin/bash
# Display Control Power Management Helper

if [ -x "/usr/local/bin/displaycontrol-smc" ]; then
    SMC="/usr/local/bin/displaycontrol-smc"
elif [ -x "/Applications/MacMate.app/Contents/Resources/smc" ]; then
    SMC="/Applications/MacMate.app/Contents/Resources/smc"
elif [ -x "/Applications/HyperMac.app/Contents/Resources/smc" ]; then
    # Tương thích helper đã cài từ HyperMac trong giai đoạn chuyển đổi.
    SMC="/Applications/HyperMac.app/Contents/Resources/smc"
elif [ -x "/Applications/DisplayControl.app/Contents/Resources/smc" ]; then
    SMC="/Applications/DisplayControl.app/Contents/Resources/smc"
else
    SMC="$(which smc 2>/dev/null || true)"
fi

if [ -z "$SMC" ] || [ ! -x "$SMC" ]; then
    echo "Error: smc binary not found"
    exit 1
fi

if [ "$(uname -m)" = "arm64" ]; then
    SMC_KEY="CHTE"
else
    SMC_KEY="BCLM"
fi

case "$1" in
    status)
        exec "$SMC" -k "$SMC_KEY" -r
        ;;
    charge-off)
        if [ "$SMC_KEY" = "CHTE" ]; then
            exec "$SMC" -k CHTE -w 01000000
        fi
        LIMIT="${2:-80}"
        if ! [ "$LIMIT" -ge 50 ] 2>/dev/null || ! [ "$LIMIT" -le 100 ] 2>/dev/null; then
            echo "Error: Intel charge limit must be between 50 and 100"
            exit 2
        fi
        printf -v LIMIT_HEX '%02x' "$LIMIT"
        exec "$SMC" -k BCLM -w "$LIMIT_HEX"
        ;;
    charge-on)
        if [ "$SMC_KEY" = "CHTE" ]; then
            exec "$SMC" -k CHTE -w 00000000
        fi
        exec "$SMC" -k BCLM -w 64
        ;;
    *)
        echo "Usage: $0 {status|charge-off|charge-on}"
        exit 1
        ;;
esac
